//@expected_bin_stdout 1:1\n

#include <helper.h>

/* A pointer written behind a typedef is still a pointer, so comparing one is
   read the same way as comparing the pointer it is written for. */
typedef void (*handler_t)(int);

static void handler(int sig) {
	(void)sig;
}

int main() {
	handler_t named = &handler;
	void (*written)(int) = &handler;

	printf("%d:%d\n", named == written, named != (handler_t)-1);

	return 0;
}
