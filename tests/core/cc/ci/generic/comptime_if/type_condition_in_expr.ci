//@expected_bin_stdout 1:0\n
//@expected_bin_stdout 1:0:2\n

#include <helper.h>

/* A comparison of data types is known once the types the declaration is
   called on are, whether it is written as the whole of a condition or as a
   part of one. What is written as a part of one is not a path the declaration
   is written on, so both paths are written, and the comparison is written as
   the 1 or the 0 it stands for. */

static int
guarded.[@T](@T x, int n) {
	if (@T == int && n > 0) {
		return 1;
	}

	return 0;
}

/* It says the same thing wherever it is written. */
static int
as_value.[@T](@T x) {
	return @T == int;
}

static int
in_a_loop.[@T](@T x) {
	int n = 0;

	while (@T != int && n < 2) {
		++n;
	}

	return n;
}

int main() {
	printf("%d:%d\n", guarded.[int](1, 5), guarded.[char]('a', 5));
	printf("%d:%d:%d\n",
	       as_value.[int](1),
	       as_value.[char]('a'),
	       in_a_loop.[char]('a'));

	return 0;
}
