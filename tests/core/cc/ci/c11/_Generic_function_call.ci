//@compile_options -s c11
//@expected_bin_stdout f:d:i\n
//@expected_bin_stdout 3:7\n
//@expected_bin_stdout 42:42:42\n

#include <helper.h>

typedef int (*fn)(int);

int
add1(int x)
{
	return x + 1;
}

fn
pick(void)
{
	return add1;
}

const char *
which_f(float x)
{
	return "f";
}

const char *
which_d(double x)
{
	return "d";
}

const char *
which_i(int x)
{
	return "i";
}

int
add(int x, int y)
{
	return x + y;
}

int
mul(int x, int y)
{
	return x * y;
}

/* The idiom a generic selection is written for: the association selected is
   what the call is made on. */
#define WHICH(x) _Generic((x), float: which_f, double: which_d, default: which_i)(x)

#define OP(x) _Generic((x), int: add, default: mul)

int main() {
	int i = 0;
	float f = 1.0f;
	double d = 1.0;
	short s = 1;

	printf("%s:%s:%s\n", WHICH(f), WHICH(d), WHICH(s));

	/* A selection is called as well when it is written on its own, the
	   parentheses of the call standing apart from it. */
	printf("%d:%d\n", OP(1)(1, 2), OP(f)(7, 1));

	/* What a selection chose is called through a pointer on a function as
	   well, whether it is written as one or behind a typedef, and a call is
	   made on what a call returned. */
	int (*raw)(int) = add1;
	fn tdef = add1;

	printf("%d:%d:%d\n",
	       _Generic(i, int: raw, default: raw)(41),
	       _Generic(i, int: tdef, default: tdef)(41),
	       _Generic(i, int: pick, default: pick)()(41));
}
