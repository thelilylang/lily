//@compile_options -s c11
//@expected_bin_stdout 1:2\n

#include <helper.h>

/* An assertion is written among the fields as much as anywhere else, and
   declares no field of its own. */
struct S {
	int a;
	_Static_assert(1, "the assertion holds");
	int b;
};

int main() {
	struct S s;

	s.a = 1;
	s.b = 2;

	printf("%d:%d\n", s.a, s.b);
}
