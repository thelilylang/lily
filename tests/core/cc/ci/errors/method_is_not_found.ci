//@compile_options --method-convention $type_$name
//@expected_compiler_error :19:14: \e[31merror\e[0m[0214]: no method of this name is written on this type
//@expected_compiler_error \e[34m19 |\e[0m \tsize_t n = v.nope();

#include <helper.h>

typedef struct Vec {
	size_t len;
} Vec;

size_t Vec_size(const Vec *self)
{
	return self->len;
}

int main()
{
	Vec v;
	size_t n = v.nope();

	return 0;
}
