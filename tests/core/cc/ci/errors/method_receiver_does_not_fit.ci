//@compile_options --method-convention $type_$name
//@expected_compiler_error :21:14: \e[31merror\e[0m[0216]: a method is called on what it takes first, and this one is written to take nothing
//@expected_compiler_error \e[34m21 |\e[0m \tsize_t n = v.size();

#include <helper.h>

// What a method is called on is what it takes first, so a function written to
// take nothing is written on nothing to be called on.
typedef struct Vec {
	size_t len;
} Vec;

size_t Vec_size(void)
{
	return 1;
}

int main()
{
	Vec v;
	size_t n = v.size();

	return 0;
}
