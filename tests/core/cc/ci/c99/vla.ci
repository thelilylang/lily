//@compile_options -s c99
//@expected_bin_stdout 1:3:4\n
//@expected_bin_stdout 7:1\n

#include <helper.h>

void
on_a_parameter(int n)
{
	int v[n];

	v[0] = 1;

	printf("%d\n", v[0]);
}

int main() {
	/* The size of an array is written on what the program holds while it
	   runs as much as on what is known before it does. */
	int n = 3;
	int v[n];

	v[0] = 1;
	v[2] = 3;

	printf("%d:%d:%d\n", v[0], v[2], v[0] + v[2]);

	/* It is written as any other expression is. */
	int twice[n * 2];

	twice[5] = 7;

	printf("%d:", twice[5]);

	on_a_parameter(2);
}
