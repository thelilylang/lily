//@compile_options -s c99
//@expected_bin_stdout 0:5:0\n
//@expected_bin_stdout 1:0:0:4\n
//@expected_bin_stdout 1:2\n

#include <helper.h>

struct P
{
	int x;
	int y;
};

int main() {
	/* An item is written on the index it is held at, and what is written on
	   no index is left as it was. */
	int one[3] = { [1] = 5 };
	int several[4] = { [0] = 1, [3] = 4 };

	printf("%d:%d:%d\n", one[0], one[1], one[2]);
	printf("%d:%d:%d:%d\n", several[0], several[1], several[2], several[3]);

	/* A struct holds its items on the fields they are written on. */
	struct P p = { .x = 1, .y = 2 };

	printf("%d:%d\n", p.x, p.y);
}
