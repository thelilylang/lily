//@compile_options -s c99
//@expected_bin_stdout 1:3:6\n
//@expected_bin_stdout 3:3\n

#include <helper.h>

#define HEAD(a, ...) a
#define ADD2(a, b, ...) ((a) + (b))
#define SUM3(a, b, c, ...) ((a) + (b) + (c))

int main() {
	printf("%d:%d:%d\\n",
	       HEAD(1, 2, 3),
	       ADD2(1, 2, 0),
	       SUM3(1, 2, 3, 0));

	/* What is written for the variadic part is given to it or left out. */
	printf("%d:%d\\n", ADD2(1, 2), ADD2(1, 2, 9));
}
