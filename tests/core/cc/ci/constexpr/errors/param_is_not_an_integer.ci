//@compile_options -s c23
//@expected_compiler_error :12:21: \e[31merror\e[0m[0210]: a param written `constexpr` holds an integer value
//@expected_compiler_error \e[34m12 |\e[0m held(constexpr char *s) {

// The value such a param holds is read as a number, and the declaration is
// instantiated on it: a value of any other data type is one nothing is
// written on yet.

#include <helper.h>

int
held(constexpr char *s) {
	return 0;
}

int main() {
	return held("a");
}
