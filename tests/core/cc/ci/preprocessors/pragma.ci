//@expected_bin_stdout 1:3\n

#include <helper.h>

/* A pragma nothing is known about is written to be passed over, rather than
   read as if it were code. */
#pragma GCC diagnostic push
#pragma pack(1)

/* `_Pragma` says what a pragma written on a line of its own says, written
   where an expression is written. */
#include <once_operator.h>
#include <once_operator.h>

int main() {
	_Pragma("GCC diagnostic pop")

	  printf("%d:%d\n", 1, operator_marker);
}
