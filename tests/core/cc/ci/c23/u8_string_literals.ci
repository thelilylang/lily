//@compile_options -s c23
//@expected_bin_stdout ab:98:1\n

#include <helper.h>

int main() {
	/* A string is written with the encoding it holds before the quote that
	   opens it, and what `u8` holds is what a `char` holds. */
	const char *encoded = u8"ab";
	const char *plain = "ab";

	printf("%s:%d:%d\n", encoded, encoded[1], encoded[0] == plain[0]);
}
