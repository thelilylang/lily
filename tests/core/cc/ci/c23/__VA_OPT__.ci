//@compile_options -s c23
//@expected_bin_stdout 1:3\n
//@expected_bin_stdout 1:0\n

#include <helper.h>

int
one(int a)
{
	return a;
}

int
two(int a, int b)
{
	return a + b;
}

/* `__VA_OPT__` stands for what is written between the parentheses that follow
   it where something is written for the variadic part, and for nothing where
   nothing is. */
#define CALL_ONE(a, ...) one(a __VA_OPT__(, ) __VA_ARGS__)
#define CALL_TWO(a, ...) two(a __VA_OPT__(, ) __VA_ARGS__)
#define COUNT(...) (0 __VA_OPT__(+ 1))

int main() {
	printf("%d:%d\n", CALL_ONE(1), CALL_TWO(1, 2));

	printf("%d:%d\n", COUNT(9), COUNT());
}
