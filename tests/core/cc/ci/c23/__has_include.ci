//@compile_options -s c23
//@expected_bin_stdout 1:0:1\n

#include <helper.h>

// C23 6.10.1: `__has_include` is written in the condition of a conditional
// inclusion directive, and stands for 1 where what it names is a header the
// `#include` search finds, 0 where it is not. The name is written the way
// `#include` writes it, between `<` and `>` or between quotes.
#if __has_include(<stddef.h>)
static int has_stddef = 1;
#else
static int has_stddef = 0;
#endif

#if __has_include(<no_such_header_is_written_anywhere.h>)
static int has_nothing = 1;
#else
static int has_nothing = 0;
#endif

// What it stands for is read as an integer, so it is written among the rest of
// a condition like any other.
#if defined(__STDC__) && __has_include(<limits.h>)
static int has_limits = 1;
#else
static int has_limits = 0;
#endif

int main() {
	printf("%d:%d:%d\\n", has_stddef, has_nothing, has_limits);

	return 0;
}
