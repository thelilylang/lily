//@compile_options -s c23
//@expected_bin_stdout 1:2\n
//@expected_bin_stdout 3\n

#include <helper.h>

/* An attribute is written before what it is written on, with the reason it is
   written for or without one. */
[[nodiscard]] int
one(void)
{
	return 1;
}

[[nodiscard("what it gives back is what it is called for")]] int
two(void)
{
	return 2;
}

[[deprecated]] int
unused_and_old(void)
{
	return 0;
}

int
three(void)
{
	return 3;
}

int main() {
	printf("%d:%d\n", one(), two());

	/* An attribute is written in the body of a function as much as outside
	   of it. */
	[[maybe_unused]] int unused = 0;

	printf("%d\n", three());
}
