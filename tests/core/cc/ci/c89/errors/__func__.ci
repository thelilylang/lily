/*@compile_options -s c89*/
/*@expected_compiler_error :10:7: \e[31merror\e[0m[0028]: cannot infer on an unknown identifier*/
/*@expected_compiler_error \e[34m10 |\e[0m \tputs(__func__);*/

#include <helper.h>

int main() {
	/* `__func__` is only declared by the compiler since C99, so before it
	   the name is read as any other, and stands for nothing. */
	puts(__func__);

	return 0;
}
