/*@compile_options -s c89 */
/*@expected_compiler_error :8:19: \e[31merror\e[0m[0003]: invalid escape*/

/* C89 3.1.3.4: the value an octal or hexadecimal escape sequence is written
   as has to be one the character it stands for can hold. `\x1ff` names one
   no `char` holds. */
int main() {
	char too_big = '\x1ff';

	return too_big;
}
