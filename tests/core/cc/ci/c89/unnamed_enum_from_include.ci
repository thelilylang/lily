/*@expected_bin_stdout 1:2:3\n*/

#include <helper.h>

/* An enumeration written with no tag is only ever reached through the
   constants it declares, since nothing can name it. Each constant is then
   generated with an enumeration of its own. */
enum { FIRST = 1, SECOND = 2 };

enum named { THIRD = 3 };

int main() {
	printf("%d:%d:%d\n", FIRST, SECOND, THIRD);

	return 0;
}
