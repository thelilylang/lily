/*@compile_options -s c89 */
/*@expected_bin_stdout 127:65:7:63:0\n*/

#include <helper.h>

/* C89 3.1.3.4: an escape sequence is written `\'`, `\"`, `\?`, `\\`, `\a`,
   `\b`, `\f`, `\n`, `\r`, `\t`, `\v`, or a value written in octal after a `\`
   or in hexadecimal after a `\x`. A hexadecimal sequence is written with as
   many digits as it takes, an octal one with three at most. */
int main() {
	char del = '\x7f';
	char upper_a = '\101';
	char alert = '\a';
	char question = '\?';
	char nul = '\0';

	printf("%d:%d:%d:%d:%d\\n", del, upper_a, alert, question, nul);

	return 0;
}
