/*@compile_options -s c89 */
/*@expected_bin_stdout PASS\n*/

#include <signal.h>
#include <helper.h>

/* C99 7.14: <signal.h> defines sig_atomic_t, the handlers no function is
   written as, and the signals. What signal gives back is the handler the
   signal was written with before, and SIG_ERR where it could not be set. */
static volatile sig_atomic_t caught = 0;

static void handler(int sig) {
	caught = sig;
}

int main() {
	if (signal(SIGINT, handler) != SIG_ERR) {
		raise(SIGINT);

		if (caught == SIGINT && signal(SIGINT, SIG_DFL) == handler) {
			printf("PASS\n");
		}
	}

	return 0;
}
