/*@compile_options -s c89 */
/*@expected_bin_stdout 2:1:3:2\n*/

#include <math.h>
#include <helper.h>

/* C99 7.12: <math.h> declares the mathematical functions and defines HUGE_VAL.
   The functions the standard gives here take and return a double. */
int main() {
	printf("%d:%d:%d:%d\n",
	       (int)sqrt(4.0),
	       (int)fabs(-1.0),
	       (int)ceil(2.5),
	       (int)floor(2.5));

	return HUGE_VAL > 0.0 ? 0 : 1;
}
