/*@compile_options -s c89*/
/*@expected_bin_stdout 1:2:1:1\n5:1\n*/

#include <helper.h>

struct S
{
	int f;
};

int id(int x)
{
	return x;
}

int main() {
	int a = 1;
	int b = 1;
	int arr[2];
	struct S s;
	struct S *p;

	arr[0] = 5;
	s.f = 1;
	p = &s;

	/* An operand is read before it is increased or decreased where the
	   operator is written after it. */
	printf("%d:%d:%d:%d\n", a++, a, b--, id(1));

	/* What is written after an operand is read on it, an index, a member and
	   the parameters of a call alike. */
	printf("%d:%d\n", arr[0], p->f);
}
