//@expected_bin_stdout hello world\n
//@expected_bin_stdout 1:1:1\n

#include <helper.h>

#define WOR "wor"

int main() {
	/* The string literals written next to one another spell a single
	   string. */
	const char *joined = "hello " WOR "ld";
	const char *two = "a" "b";
	const char *one = "ab";

	puts(joined);

	printf("%d:%d:%d\n",
	       two[0] == one[0],
	       two[1] == one[1],
	       two[2] == '\0');
}
