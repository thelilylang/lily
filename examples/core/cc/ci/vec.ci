// Transpile this with a method convention, which is what makes a function
// callable on what it takes first:
//
//     cic --std c23 --method-convention $type_$name -f examples/ci/vec.ci
//
// or with `method_convention: $type_$name` written in `CI.yaml`. Without one
// nothing is a method, and the calls below are written as `Vec_push(&v, i)`.

#include <stddef.h>
#include <stdlib.h>
#include <stdio.h>

#define DEFAULT_VEC_CAPACITY 4

typedef struct Vec.[@T] {
	@T *buffer;
	size_t len;
	size_t capacity;
} Vec.[@T];

// A constructor is called on nothing, so it is not a method and is written by
// its name like any other function.
Vec.[@T] Vec_new.[@T]() {
	return (Vec.[@T]){
		.buffer = NULL,
		.len = 0,
		.capacity = DEFAULT_VEC_CAPACITY
	};
}

void
Vec_push.[@T](Vec.[@T] *self, @T item)
{
	if (!self->buffer) {
		self->buffer = malloc(sizeof(@T) * self->capacity);
	}

	if (self->len == self->capacity) {
		self->capacity <<= 1;
		self->buffer = realloc(self->buffer, sizeof(@T) * self->capacity);
	}

	self->buffer[self->len] = item;
	++self->len;
}

@T *
Vec_get.[@T](Vec.[@T] *self, size_t index)
{
	return index >= self->len ? NULL : &self->buffer[index];
}

void
Vec_free.[@T](Vec.[@T] *self)
{
	if (self->buffer) {
		free(self->buffer);
	}
}

int main() {
	Vec.[int] v = Vec_new.[int]();

	// The address of `v` is taken by the call, as each of these is written on
	// a `Vec.[@T] *`. The instance the call is made on is the one `v` is
	// written with, which is `[int]`.
	for (int i = 0; i < 100; ++i) {
		v.push(i);
	}

	for (int j = 0; j < 100; ++j) {
		printf("%d: %d\n", j, *v.get(j));
	}

	v.free();
}
